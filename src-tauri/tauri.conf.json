{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mythpen Sync Dev",
  "version": "0.0.9",
  "identifier": "community.mythpen.sync.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev:desktop",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Mythpen Sync Dev",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mythpen-server"
    ],
    "resources": {
      "resources/sync-keyring/": "sync-keyring/"
    }
  }
}
